# Copy to .env (gitignored) and fill in. This is the file both
# scripts/submit.sh (via upstream scripts/register_miner.py) and
# harness/local_eval.py read.

# ---------------------------------------------------------------- bittensor
PHYLAX_NETUID=76
SUBTENSOR_NETWORK=finney
WALLET_NAME=default
WALLET_HOTKEY=sn76
BITTENSOR_DIR=~/.bittensor

# ---------------------------------------------------------------- track
# One hotkey lives in exactly one track. Changing this after registering
# moves which emission pool we compete in.
#   repositories 0.30 | packages 0.30 | mcp_servers 0.22 | skills 0.18
PHYLAX_TRACK=

# ---------------------------------------------------------------- server
PHYLAX_SERVER_URL=https://api.phyi.dev
# Pinned upstream in .env.example so the client refuses an impersonator.
# Re-check with: curl https://api.phyi.dev/v1/server-identity
PHYLAX_SERVER_HOTKEY=a53f8e390446e31cd077517e44e585c0e0474bbd5b1db5864c52fb07bcbe541c

# ---------------------------------------------------------------- agent
# Our agent. Submitted as code; the validator owns the sandbox image.
PHYLAX_AGENT_CODE_PATH=agent/phylax_agent.py
PHYLAX_AGENT_ENTRYPOINT=agent_main

# Funds our agent's inference through the validator's metered proxy.
# Must start with cpk_ (Chutes) or sk-or- (OpenRouter). SECRET — .env only.
PHYLAX_EXECUTION_API_KEY=
PHYLAX_INFERENCE_MODEL=
PHYLAX_MINER_LABEL=

# ---------------------------------------------------------------- lab
# Upstream read-only checkout the harness imports scoring code from.
PHYLAX_UPSTREAM=/root/labs/phylax-subnet
